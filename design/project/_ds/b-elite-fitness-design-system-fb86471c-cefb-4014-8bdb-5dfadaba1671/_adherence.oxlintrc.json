{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/schedule/**",
              "components/social/**",
              "ui_kits/instagram/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|Instrument Serif|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, Instrument Serif, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|thickness|dot|width|style|key|ref|className|style|children)$/]",
        "message": "<BrandRule> doesn't accept that prop. Declared props: color, thickness, dot, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|iconRight|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onClick, iconRight, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'inverse' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptionTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<CaptionTag> doesn't accept that prop. Declared props: children, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptionTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:block|outline)$/]",
        "message": "<CaptionTag> variant must be one of 'block' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|address|dark|style|key|ref|className|style|children)$/]",
        "message": "<ContactBar> doesn't accept that prop. Declared props: phone, address, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DaySlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|label|key|ref|className|style|children)$/]",
        "message": "<DaySlot> doesn't accept that prop. Declared props: time, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|base|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|lockup|mark)$/]",
        "message": "<Logo> variant must be one of 'full' | 'lockup' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|stars|source|style|key|ref|className|style|children)$/]",
        "message": "<ReviewCard> doesn't accept that prop. Declared props: quote, author, stars, source, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|label|type|key|ref|className|style|children)$/]",
        "message": "<ScheduleCell> doesn't accept that prop. Declared props: time, label, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleCell'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:reformer|matwork|yoga)$/]",
        "message": "<ScheduleCell> type must be one of 'reformer' | 'matwork' | 'yoga'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServicePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ServicePill> doesn't accept that prop. Declared props: children, active, onClick, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
